---
import originalHtml from '../generated/original-homepage.html?raw';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import HeroTagline from '../components/HeroTagline.astro';
import { islands } from '../lib/islands';
import { getHomepage } from '../lib/data';
import { splitLegacyHomepage } from '../../scripts/split-home.mjs';

// The source homepage is copied into src/generated before dev/build.
// Importing it as Vite raw text embeds the design in the Worker bundle;
// this intentionally avoids runtime Node filesystem access on Cloudflare.
const { head, before, after } = splitLegacyHomepage(originalHtml);
const homepage = (await getHomepage()).data.homepage;
---
<!doctype html>
<html lang="en">
  <head>
    <Fragment set:html={head} />
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body data-cms-page="home">
    <Fragment set:html={before} />
    <TinaIsland name="hero" wrapper={islands.hero.wrapper} params={{}} primary>
      <HeroTagline data={homepage} />
    </TinaIsland>
    <Fragment set:html={after} />
  </body>
</html>
